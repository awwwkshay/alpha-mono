# Slack credentials
# Bot token from https://api.slack.com/apps → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Signing secret from https://api.slack.com/apps → Basic Information
SLACK_SIGNING_SECRET=your-signing-secret-here

# Google AI API key (required for gemini/gemini-2.0-flash)
GEMINI_API_KEY=your-gemini-api-key-here
